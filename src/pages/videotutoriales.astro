---
import Base from "../layouts/Base.astro";

const updated = "2026-07-08";

/* Videos del canal @VMCsubastas — título = pregunta del comprador (Fase F) */
const videos = [
  {
    id: "DGFzz3IY_hg",
    title: "¿Cómo me registro?",
    articleTitle: "¡Registrarte es fácil y rápido!",
    articleHref: "/categorias/registro/registrarte-es-facil-y-rapido",
  },
  {
    id: "BArqY0cM39I",
    title: "¡Consignar es necesario para participar!",
    articleTitle: "¡Consignar es necesario para participar!",
    articleHref: "/categorias/consignacion/consignar-es-necesario-para-participar",
  },
  {
    id: "3wqedeVF4d8",
    title: "¿Cómo agendo una visita?",
    articleTitle: "Las visitas e inspecciones físicas",
    articleHref: "/categorias/visitas/las-visitas-e-inspecciones-fisicas",
  },
];

/* VideoObject JSON-LD (SEO/GEO) */
const videosJsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  inLanguage: "es",
  itemListElement: videos.map((v, i) => ({
    "@type": "VideoObject",
    position: i + 1,
    name: v.title,
    thumbnailUrl: `https://i.ytimg.com/vi/${v.id}/hqdefault.jpg`,
    embedUrl: `https://www.youtube-nocookie.com/embed/${v.id}`,
    uploadDate: updated,
  })),
};
---

<Base
  title="Videotutoriales · Centro de Ayuda VMC Subastas"
  description="Guías en video paso a paso para participar en las subastas de VMC: cómo registrarte, cómo consignar y cómo agendar una visita."
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(videosJsonLd)} />

  <main class="mx-auto max-w-2xl px-4 py-16 sm:px-6">
    <nav aria-label="Ruta de navegación" class="text-center text-xs font-semibold tracking-wide text-vault-700/50">
      <a href="/" class="hover:text-vault-500">Centro de Ayuda</a> <span aria-hidden="true" class="mx-1.5">/</span> <span>Videotutoriales</span>
    </nav>
    <h1 class="mt-4 text-center text-2xl font-extrabold tracking-tight text-vault-900 sm:text-3xl">
      ¡VIDEOTUTORIALES!
    </h1>
    <p class="mt-3 text-center text-sm text-vault-700/60 sm:text-base">
      Guías en video paso a paso del canal de <a
        href="https://www.youtube.com/@VMCsubastas"
        class="font-bold text-orange-vmc underline decoration-2 underline-offset-2"
        >VMC Subastas en YouTube</a
      >.
    </p>

    <div class="mt-10 space-y-10">
      {
        videos.map((v) => (
          <section aria-label={v.title}>
            <h2 class="text-lg font-extrabold tracking-tight text-vault-900 sm:text-xl">
              {v.title}
            </h2>
            <div class="mt-3 aspect-video overflow-hidden rounded-2xl border-2 border-vault-900/10 shadow-sm">
              <iframe
                class="h-full w-full"
                src={`https://www.youtube-nocookie.com/embed/${v.id}`}
                title={v.title}
                loading="lazy"
                allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                referrerpolicy="strict-origin-when-cross-origin"
                allowfullscreen
              />
            </div>
            <p class="mt-2 text-sm text-vault-700/70 sm:text-base">
              ¿Prefieres leerlo? Revisa el artículo <a
                href={v.articleHref}
                class="font-bold text-orange-vmc underline decoration-2 underline-offset-2"
                >{v.articleTitle}</a
              >.
            </p>
          </section>
        ))
      }
    </div>
  </main>
</Base>
