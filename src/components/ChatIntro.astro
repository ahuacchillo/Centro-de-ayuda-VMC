---
/* Bloque de presentación de Subastín — abre todos los artículos */
---

<section aria-label="Presentación de Subastín" class="msg space-y-3" style="--d:.1s">
  <div class="flex items-center gap-3">
    <span
      aria-hidden="true"
      class="avatar-fill flex h-10 w-10 shrink-0 items-center justify-center rounded-full text-sm font-extrabold text-white ring-2 ring-white"
      >S</span
    >
    <span class="bg-gradient-to-br from-vault-500 to-vault-700 bg-clip-text text-base font-bold leading-none tracking-wide text-transparent">Subastín</span>
  </div>
  <div
    class="msg-card rounded-2xl rounded-tl-md px-5 py-4 shadow-[0_2px_10px_rgba(32,0,104,0.06)] sm:px-6 sm:py-5"
  >
    <p class="bg-gradient-to-br from-vault-500 to-vault-700 bg-clip-text text-base font-extrabold text-transparent">
      ¡Hola! Soy Subastín
    </p>
    <p class="mt-1 text-sm text-vault-900/75">
      ¡Y estoy aquí para ayudarte a resolver tus dudas!
    </p>
  </div>
</section>
