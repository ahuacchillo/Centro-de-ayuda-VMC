---
/* Cabecera editorial de artículo: breadcrumb + título con acento en gradiente */
interface Props {
  category: string;
  categorySlug: string;
  subtitle?: string;
  /** Fecha ISO de última actualización — señal de frescura visible (SEO/GEO) */
  updated?: string;
}
const { category, categorySlug, subtitle, updated } = Astro.props;

const updatedLabel =
  updated &&
  new Date(`${updated}T00:00:00`).toLocaleDateString("es-PE", {
    day: "numeric",
    month: "long",
    year: "numeric",
  });
---

<header class="mx-auto max-w-2xl px-4 pt-8 sm:px-6 sm:pt-12">
  <nav aria-label="Ruta de navegación" class="text-xs font-semibold tracking-wide text-vault-700/50">
    <a href="/" class="hover:text-vault-500">Centro de Ayuda</a>
    <span aria-hidden="true" class="mx-1.5">/</span>
    <a href={`/categorias/${categorySlug}`} class="hover:text-vault-500">{category}</a>
  </nav>
  <h1 class="mt-4 text-3xl leading-tight font-extrabold tracking-tight text-vault-900 sm:text-4xl">
    <slot />
  </h1>
  {subtitle && <p class="mt-3 text-sm text-vault-700/60 sm:text-base">{subtitle}</p>}
  {
    updatedLabel && (
      <p class="mt-2 text-xs text-vault-700/45">
        Actualizado: <time datetime={updated}>{updatedLabel}</time>
      </p>
    )
  }
</header>
